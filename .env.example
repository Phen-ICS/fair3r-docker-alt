CKAN_VERSION=2.11.5

#dev or prod
CKAN_DEBUG=false
CKAN_PORT=5000

# Nginx
NGINX_SSLPORT_HOST=8085
NGINX_SSLPORT=443

# DB
CKAN_DB_PORT_EXT=5435

CKAN_SITE_URL=http://localhost:5000
CKAN_INTERNAL_SITE_URL=http://ckan:5000

CKAN_DB_HOST=db
CKAN_DB_PORT=5432
CKAN_DB_NAME=ckan
CKAN_DB_USER=ckan
CKAN_DB_PASSWORD=ckan

CKAN_DATASTORE_DB_NAME=datastore
CKAN_DATASTORE_DB_USER=ckan_datastore
CKAN_DATASTORE_DB_PASSWORD=ckan_datastore
CKAN_DATASTORE_READONLY_USER=ckan_datastore_ro
CKAN_DATASTORE_READONLY_PASSWORD=ckan_datastore_ro

# Test DB names
CKAN_TEST_DB_NAME=ckan_test
CKAN_DATASTORE_TEST_DB_NAME=datastore_test

# complete these for deployments
CKAN_SESSION_SECRET=change-me-session-secret
CKAN_SECRET_KEY=change-me-secret-key
CKAN_APP_INSTANCE_UUID=change-me-app-instance-uuid
CKAN_BOOTSTRAP_SYSADMIN_NAME=
CKAN_BOOTSTRAP_SYSADMIN_EMAIL=
CKAN_BOOTSTRAP_SYSADMIN_PASSWORD=

# GitLab Package Registry (PyPI API)
GITLAB_EXTENSIONS_PYPI_HOST=gitlab.igbmc.u-strasbg.fr
FAIR3R_EXTENSION_PYPI_TOKEN=
PAGE_EXTENSION_PYPI_TOKEN=
DOI_EXTENSION_PYPI_TOKEN=
PLOTLY_EXTENSION_PYPI_TOKEN=
FAIR3R_PYPI_PROJECT_ID=862
PAGE_PYPI_PROJECT_ID=863
DOI_PYPI_PROJECT_ID=860
PLOTLY_PYPI_PROJECT_ID=891

# Native VM Ansible deploy uses the same registry; see deploy/README.md.

# add each extension to the list of plugins to be installed and activated (ie: space-separated list of extension names)
CKAN_EXTRA_PLUGINS=fair3r doi pages plotly_explorer
CKAN_EXTRA_VIEWS=plotly_explorer

# Options for extensions
# Fair3R (use upper-case; native VM deploys set ckanext.fair3r.context to VALIDATION / INTEGRATION / PRODUCTION)
FAIR3R_CONTEXT=PRODUCTION
FAIR3R_ENABLE_FDF_INTEGRATION=true

# Contact
CONTACT_MAIL=contact@example.com

# DOI
DOI_ACCOUNT_NAME=
DOI_ACCOUNT_PASSWORD=
DOI_PREFIX=
DOI_PUBLISHER=
DOI_TEST_MODE=True
DOI_SITE_TITLE=Fair3R